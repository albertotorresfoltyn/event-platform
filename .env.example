APP_NAME=event-platform
LOG_LEVEL=INFO
QUEUE_MAX_SIZE=10000
QUEUE_VISIBILITY_TIMEOUT_SECONDS=30
QUEUE_MAX_RECEIVE_COUNT=5
MONGO_URL=mongodb://localhost:27017
MONGO_DATABASE=event_platform
WORKER_ENABLED=true
WORKER_BATCH_SIZE=10
WORKER_POLL_WAIT_SECONDS=1
RETRY_BASE_DELAY_SECONDS=1
RETRY_MAX_DELAY_SECONDS=60
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=events
REDIS_URL=redis://localhost:6379/0
REALTIME_STATS_TTL_SECONDS=10
REALTIME_STATS_WINDOW_SECONDS=3600
